{
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/guide/",
      "destination": "/guide.html"
    },
    {
      "source": "/diff",
      "destination": "/diff.html"
    },
    {
      "source": "/diff/",
      "destination": "/diff.html"
    },
    {
      "source": "/index",
      "destination": "/index.html"
    },
    {
      "source": "/index/",
      "destination": "/index.html"
    },
    {
      "source": "/overview",
      "destination": "/index.html"
    },
    {
      "source": "/overview/",
      "destination": "/index.html"
    },
    {
      "source": "/builds",
      "destination": "/index.html"
    },
    {
      "source": "/builds/",
      "destination": "/index.html"
    },
    {
      "source": "/covenants",
      "destination": "/index.html"
    },
    {
      "source": "/covenants/",
      "destination": "/index.html"
    },
    {
      "source": "/operators",
      "destination": "/index.html"
    },
    {
      "source": "/operators/",
      "destination": "/index.html"
    },
    {
      "source": "/equipment",
      "destination": "/index.html"
    },
    {
      "source": "/equipment/",
      "destination": "/index.html"
    },
    {
      "source": "/strategies",
      "destination": "/index.html"
    },
    {
      "source": "/strategies/",
      "destination": "/index.html"
    },
    {
      "source": "/enemies",
      "destination": "/index.html"
    },
    {
      "source": "/enemies/",
      "destination": "/index.html"
    },
    {
      "source": "/tools",
      "destination": "/index.html"
    },
    {
      "source": "/tools/",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/settings/",
      "destination": "/index.html"
    },
    {
      "source": "/box",
      "destination": "/index.html"
    },
    {
      "source": "/box/",
      "destination": "/index.html"
    },
    {
      "source": "/builds/:id",
      "destination": "/index.html"
    },
    {
      "source": "/builds/:id/",
      "destination": "/index.html"
    },
    {
      "source": "/builds/:id/edit",
      "destination": "/index.html"
    },
    {
      "source": "/builds/:id/edit/",
      "destination": "/index.html"
    },
    {
      "source": "/covenants/:id",
      "destination": "/index.html"
    },
    {
      "source": "/covenants/:id/",
      "destination": "/index.html"
    },
    {
      "source": "/enemies/:id",
      "destination": "/index.html"
    },
    {
      "source": "/enemies/:id/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/bundles/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/*.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/img/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/icons/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/*.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:page",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:page/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/builds/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/covenants/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/enemies/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "nodeVersion": "24.18.0"
}
