{
  "buildCommand": "python3 scripts/build.py",
  "installCommand": "true",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/guide", "destination": "/guide.html" },
    { "source": "/index", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [
      { "key": "Content-Type", "value": "application/manifest+json" },
      { "key": "Cache-Control", "value": "no-cache" }
    ] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/guide", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/js/*", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/data/*", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/css/*", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/img/*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/assets/icons/*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/assets/fonts/*.woff2", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
