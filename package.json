    "vite": "8.3.8",
    "vue-tsc": "3.3.14",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.73.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "vue-eslint-parser": "10.3.0",
    "prettier": "3.10.1"
